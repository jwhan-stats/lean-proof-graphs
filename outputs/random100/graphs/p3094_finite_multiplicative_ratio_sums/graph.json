        "proof_fragment": "  have hA : (∑ e : I, (∑ d : I, r (d, e))⁻¹) = 1 := by\n    have hterm : ∀ e : I,\n        (∑ d : I, r (d, e))⁻¹ =\n          r (e, b) / (∑ d : I, r (d, b)) := by\n      intro e\n      calc\n        (∑ d : I, r (d, e))⁻¹\n            = ((∑ d : I, r (d, b)) / r (e, b))⁻¹ := by\n              congr 1\n              rw [div_eq_mul_inv, Finset.sum_mul]\n              apply Finset.sum_congr rfl\n              intro d _\n              calc\n                r (d, e) = r (d, b) * r (b, e) := hr_mul d e b\n                _ = r (d, b) * (r (e, b))⁻¹ := by rw [hinv e b]\n        _ = r (e, b) / (∑ d : I, r (d, b)) := inv_div _ _\n    calc\n      (∑ e : I, (∑ d : I, r (d, e))⁻¹)\n          = ∑ e : I, r (e, b) / (∑ d : I, r (d, b)) := by\n            apply Finset.sum_congr rfl\n            intro e _\n            exact hterm e\n      _ = (∑ e : I, r (e, b)) / (∑ d : I, r (d, b)) := by\n            rw [← Finset.sum_div]\n      _ = (∑ d : I, r (d, b)) / (∑ d : I, r (d, b)) := rfl\n      _ = 1 := div_self (hsum_ne b)",
