digraph dependency_graph {
  rankdir=LR;
  graph [bgcolor=white];
  node [fontname=Helvetica];
  "n_goal" [shape=doubleoctagon, color="#D97706", label="goal\n∑ j ∈ Finset.range (i + 1), ↑(i - j) * √2 ^ j < (4 + 3 * √2) * √2 ^ i"];
  "r_h_goal" [shape=diamond, label="Real.one_lt_sqrt_two", color="#D97706"];
  "r_h_goal" -> "n_goal";
}
