digraph dependency_graph {
  rankdir=LR;
  graph [bgcolor=white];
  node [fontname=Helvetica];
  "n_goal" [shape=doubleoctagon, color="#D97706", label="goal\n∃ M, (∀ (x : ↥M), ∃ l, (∀ a ∈ l, AddIrreducible a) ∧ l.sum = x) ∧ ∀ (x : ↥M), {n | ∃ l, l.length = n ∧ (∀ a ∈ l, AddIrreducible a) ∧ l.sum = x} ≠ {2}"];
  "r_h_goal" [shape=diamond, label="Subtype.ext", color="#D97706"];
  "r_h_goal" -> "n_goal";
}
