digraph dependency_graph {
  rankdir=LR;
  graph [bgcolor=white];
  node [fontname=Helvetica];
  "n_goal" [shape=doubleoctagon, color="#D97706", label="goal\n(∀ (A : Set X), ∀ x ∈ closure A, ∃ B ⊆ A, B.Countable ∧ x ∈ closure B) ↔ ∀ (Y : Type v) [inst : TopologicalSpace Y] [FirstCountableTopology Y] (A : Set (X × Y)), ∀ p ∈ closure A, ∃ B ⊆ A, B.Countable ∧ p ∈ closure B"];
  "r_h_goal" [shape=diamond, label="Homeomorph.image_closure + Homeomorph.preimage_closure + countablyTight_prod_firstCountable", color="#D97706"];
  "r_h_goal" -> "n_goal";
}
