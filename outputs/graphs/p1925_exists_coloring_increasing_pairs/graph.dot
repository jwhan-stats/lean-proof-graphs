digraph dependency_graph {
  rankdir=LR;
  graph [bgcolor=white];
  node [fontname=Helvetica];
  "n_goal" [shape=doubleoctagon, color="#D97706", label="goal\n∃ c, (∀ (n m : ℕ), n < m → c (n, m) < m) ∧ ∀ (n k : ℕ) (B : Set ℕ), B.Infinite → ∃ m ∈ B, n < m ∧ k ≤ c (n, m)"];
  "r_h_goal" [shape=diamond, label="Nat.le_max_left + Nat.le_max_right + Set.Infinite.exists_gt", color="#D97706"];
  "r_h_goal" -> "n_goal";
}
