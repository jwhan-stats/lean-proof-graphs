digraph dependency_graph {
  rankdir=LR;
  graph [bgcolor=white];
  node [fontname=Helvetica];
  "n_goal" [shape=doubleoctagon, color="#D97706", label="goal\n⨆ x, ENNReal.ofReal |f x - g x| = sInf {d | ∃ ε, d = ↑ε ∧ ∀ (a b : ℝ), a < b → g ⁻¹' Set.Icc a b ⊆ f ⁻¹' Set.Icc (a - ↑ε) (b + ↑ε) ∧ f ⁻¹' Set.Icc a b ⊆ g ⁻¹' Set.Icc (a - ↑ε) (b + ↑ε)}"];
  "r_h_goal" [shape=diamond, label="ENNReal.coe_toNNReal + ENNReal.ofReal_coe_nnreal + ENNReal.ofReal_le_coe", color="#D97706"];
  "r_h_goal" -> "n_goal";
}
