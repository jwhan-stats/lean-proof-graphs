digraph dependency_graph {
  rankdir=LR;
  graph [bgcolor=white];
  node [fontname=Helvetica];
  "n_goal" [shape=doubleoctagon, color="#D97706", label="goal\n(Function.Commute ⇑φ fun a => φ a + a) ∧ ∀ (x y : A), (fun a => φ a + a) x = φ y → ∃! z, φ z = x ∧ (fun a => φ a + a) z = y"];
  "r_h_goal" [shape=diamond, label="AddMonoidHom.map_sub + Eq.symm + add_comm", color="#D97706"];
  "r_h_goal" -> "n_goal";
}
